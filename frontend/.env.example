# Provider and Model
PARADOX_AI_PROVIDER=agy
PARADOX_AI_MODEL=gemini-3.8-flash-high
PARADOX_AI_REASONING_EFFORT=medium

# Optional path if agy.exe is not in system PATH
# PARADOX_AGY_EXECUTABLE=C:\Users\<USER>\AppData\Local\agy\bin\agy.exe

# Timeouts & Pooling
PARADOX_AGY_REQUEST_TIMEOUT_MS=240000
PARADOX_AGY_COMMAND_TIMEOUT_MS=60000
PARADOX_AGY_INITIALIZATION_TIMEOUT_MS=45000
PARADOX_AGY_SESSION_IDLE_TIMEOUT_MS=600000
PARADOX_AGY_MAX_SESSIONS=8

# Backend Services
ASTRA_DETERMINISTIC_BACKEND_URL=http://127.0.0.1:5000
PORT=8000
